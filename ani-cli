  <div class="container">
EOF
        page_idx=1
        for img_url in $page_urls; do
            printf '    <img src="%s" loading="lazy" alt="Page %s">\n' "$img_url" "$page_idx" >> "$html_file"
            page_idx=$((page_idx + 1))
        done
